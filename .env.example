APP_NAME="Techmate API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=techmate_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production (HTTPS): set SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true and SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Phase 4: public API ---
# Inbox for new-lead / distributor-application alerts (leave empty to disable internal alerts)
TECHMATE_SALES_EMAIL=
# Comma-separated proxy IPs/CIDRs whose X-Forwarded-* headers are trusted (empty = trust none)
TRUSTED_PROXIES=
TECHMATE_NOTIFICATION_QUEUE=default
API_READ_RATE_PER_MINUTE=120
API_SUBMIT_RATE_PER_MINUTE=6
API_SUBMIT_RATE_PER_HOUR=30

# Phase 5 admin panel (/admin)
# Optional webhook so the Next.js site refreshes immediately after admin changes.
# FRONTEND_REVALIDATE_SECRET must equal REVALIDATE_SECRET in the frontend .env.
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
# Used only by `php artisan techmate:create-admin` in automated deployments; never commit a value.
# TECHMATE_ADMIN_PASSWORD=

# --- Phase 7: sales workflow ---
# Business timezone for dates shown to staff/customers and for "today" in follow-ups (storage stays UTC).
TECHMATE_TIMEZONE=Asia/Kolkata
# Inbox that receives new-order notices (falls back to TECHMATE_SALES_EMAIL).
TECHMATE_OPERATIONS_EMAIL=
# Quotation defaults pre-filled in the editor; the accountant owns the real tax rule.
TECHMATE_QUOTATION_VALID_DAYS=30
TECHMATE_DEFAULT_TAX_RATE=18
TECHMATE_DEFAULT_CURRENCY=INR
# Phase 7 needs a real mailer, a running queue worker and the scheduler (see docs/sales-workflow.md#operations):
#   php artisan queue:work --queue=default --tries=1
#   php artisan schedule:work        (local)  /  * * * * * php artisan schedule:run  (production cron)

# --- Google reviews (Places API New) ---
# Server-side key ONLY (restrict it to "Places API (New)" and your server IP). Never commit a real value.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=
# Public Google Maps listing / reviews URL, used if Google does not return one
GOOGLE_MAPS_REVIEWS_URL=
GOOGLE_PLACES_LANGUAGE=en
# Keep short: Google's terms limit how long place content may be cached
GOOGLE_REVIEWS_CACHE_SECONDS=3600
