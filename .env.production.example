# Production template. Copy to .env on the server and fill in real values; never commit the result.
APP_NAME="Techmate Industries"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.example.com
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=https://www.example.com
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

TECHMATE_SALES_EMAIL=
# IPs/CIDRs of your load balancer / reverse proxy
TRUSTED_PROXIES=
